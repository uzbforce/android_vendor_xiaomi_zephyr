on property:sys.boot_completed=1
    chmod 0664 /sys/class/Charging_Adapter/pd_adapter/usbpd_verifed
    chmod 0664 /sys/class/Charging_Adapter/pd_adapter/request_vdm_cmd
    chmod 0664 /sys/class/Charging_Adapter/pd_adapter/verify_process
    chmod 0664 /sys/class/power_supply/usb/pd_authentication

service batterysecret /vendor/bin/batterysecret
    class last_start
    user root
    group system system wakelock
    disabled
    seclabel u:r:batterysecret:s0

# batterysecret is Xiaomi's PD charger authentication daemon. Its SELinux
# domain is not part of this tree, so it is never started: init could not
# setexeccon() into it, the service died with status 6, and because it has
# updatable components init respawned it every five seconds forever - that
# restart storm is what heated the device and drained the battery. See
# never_start() in device/xiaomi/zephyr/extract-files.py.

#run batterysecret in off-charge mode
on charger
    chmod 0664 /sys/class/Charging_Adapter/pd_adapter/usbpd_verifed
    chmod 0664 /sys/class/Charging_Adapter/pd_adapter/request_vdm_cmd
    chmod 0664 /sys/class/Charging_Adapter/pd_adapter/verify_process
    chmod 0664 /sys/class/power_supply/usb/pd_authentication
