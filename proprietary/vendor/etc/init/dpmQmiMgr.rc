#start dpmQmiMgr service
service dpmQmiMgr /system/vendor/bin/dpmQmiMgr
    class hal
    user system
    group system

on property:persist.vendor.dpm.vndr.halservice.enable=*
   start dpmQmiMgr

on property:persist.vendor.dpm.vndr.halservice.enable=0
   stop dpmQmiMgr
