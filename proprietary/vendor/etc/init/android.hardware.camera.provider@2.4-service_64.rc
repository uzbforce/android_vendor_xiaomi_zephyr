on boot
    # Add a cpuset for the camera daemon
    # We want all cores for camera
    mkdir /dev/cpuset/camera-daemon
    write /dev/cpuset/camera-daemon/cpus 0-7
    write /dev/cpuset/camera-daemon/mems 0
    chown cameraserver cameraserver /dev/cpuset/camera-daemon
    chown cameraserver cameraserver /dev/cpuset/camera-daemon/tasks
    chmod 0660 /dev/cpuset/camera-daemon/tasks

service vendor.camera-provider-2-4 /vendor/bin/hw/android.hardware.camera.provider@2.4-service_64
    override
    interface android.hardware.camera.provider@2.4::ICameraProvider legacy/0
    interface vendor.qti.hardware.camera.postproc@1.0::IPostProcService camerapostprocservice
    class hal
    user cameraserver
    group audio camera input drmrpc oem_2907
    ioprio rt 4
    capabilities SYS_NICE
    writepid /dev/cpuset/camera-daemon/tasks /dev/stune/foreground/tasks

# on property:vendor.camera.vm.status=open
#     write /proc/sys/vm/watermark_scale_factor 150
#     write /proc/sys/vm/swappiness 10

# on property:vendor.camera.vm.status=close
#     write /proc/sys/vm/watermark_scale_factor 60
#     write /proc/sys/vm/swappiness 150

on property:vendor.camera.vm.dropcache=1
    write /proc/sys/vm/drop_caches 1
    setprop vendor.camera.vm.dropcache 0

on property:vendor.camera.vm.status=*
    exec u:r:vendor_qti_init_shell:s0 -- /vendor/bin/init.qti.cam.perfopt.sh
